# Copy to .env (gitignored): `cp -n .env.example .env`. Read by the FastAPI server and by docker compose.
# Keys live only here, server-side — never in the frontend or in git.

# --- AI Mentor: one key is enough. AI_PROVIDER=auto picks gemini > deepseek > openai ---
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# AI_TIMEOUT_SECONDS=45
# AI_HISTORY_TURNS=8

# --- Learning ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
SRS_NEW_CARDS_PER_DAY=15

# --- Server ---
# DATABASE_URL=sqlite:////absolute/path/toeic_lab.db   # default: server/data/toeic_lab.db
# Browser origins allowed to call the API directly. Not needed for the Next.js app (it goes through its BFF proxy);
# add e.g. https://<user>.github.io when the static legacy UI is hosted on another domain.
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:8000,http://127.0.0.1:8000
WEB_APP_URL=http://localhost:3005
LEGACY_UI_ENABLED=true
DEBUG=false

# --- Telegram study reminders (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- docker compose ---
# API_BIND=127.0.0.1   # listen on localhost only when a reverse proxy (with auth) sits in front
# WEB_BIND=127.0.0.1
# HOST_PORT=8000
# WEB_PORT=3005
