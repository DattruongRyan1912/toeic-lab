# Python
.venv/
server/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / Next.js (apps/web has its own .gitignore as well)
node_modules/
.next/

# Secrets: only the example file is committed
.env
.env.*
!.env.example

# Runtime data
server/cache/*.mp3
server/cache/*.tmp
server/data/backups/
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/*.bak*
server/data/*.db.bak*
server/data/audio/
server/toeic_data.db

# Local inputs for the legacy HTML generators (scripts/build_full_frontend.py, update_frontend_corpus.py)
scratch/

.DS_Store

# Auto-generated JWT signing key (server/config.py) when SECRET_KEY is not set
server/data/.jwt_secret
